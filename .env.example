# This file is for documentation purposes only. 
# Copy this file to .env.local and fill in the values.

# ===== CORE DATABASE =====
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# Database connection pool settings (optional)
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT=5000
DB_SCHEMA_CACHE_SIZE=1000

# ===== AUTHENTICATION =====
# REQUIRED: You can generate a secret with `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Optional alias supported by runtime checks and auth bootstrap
AUTH_SECRET=

# REQUIRED: The URL where your app is hosted (e.g., http://localhost:3000 in dev)
NEXTAUTH_URL=http://localhost:3000

# Server-only comma-separated allowlists for real operator accounts.
# Keep these unprefixed so they are never exposed to the browser bundle.
AUTH_OWNER_EMAILS=
AUTH_ADMIN_EMAILS=

# REQUIRED: Encryption seed for API keys - generate with `openssl rand -base64 32`
# WARNING: Never use the default! API keys will be insecure without this.
API_KEY_ENCRYPTION_SEED=

# Optional: You can generate a secret with `openssl rand -base64 32`
SECURE_STORAGE_SECRET=
# Optional deterministic override for client-side secure storage tests/dev
NEXT_PUBLIC_SECURE_STORAGE_KEY=

# ===== EXPERIMENTAL / INTERNAL FEATURES =====
# Teams are intentionally outside the supported production scope.
# Leave disabled unless explicitly testing the internal teams API.
ENABLE_TEAMS_API=false

# ===== OAUTH PROVIDERS =====
# Configure at least one provider to allow new account creation.
# Production Google callback:
# https://multi-llm-chat-assistant.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production GitHub callback:
# https://multi-llm-chat-assistant.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===== LLM API KEYS =====
# OpenAI API Key
OPENAI_API_KEY=

# Anthropic (Claude) API Key
ANTHROPIC_API_KEY=

# Google AI (Gemini) API Key
GOOGLE_AI_API_KEY=

# OpenRouter API Key
OPENROUTER_API_KEY=

# Kimi / Moonshot AI (optional; used by the Python orchestration sidecar)
MOONSHOT_API_KEY=

# ===== OPTIONAL BILLING =====
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ===== OPTIONAL SIDECAR =====
# Reachable FastAPI sidecar base URL for orchestration/health checks
PYTHON_CORE_URL=

# ===== OPTIONAL APP METADATA =====
# Used for OpenRouter attribution headers and UI branding overrides
NEXT_PUBLIC_APP_NAME=MultiLLM Chat Assistant
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== SCALING & PERFORMANCE =====
# Redis for distributed caching and rate limiting (optional)
REDIS_URL=redis://localhost:6379

# Optional outbound LLM request tuning
LLM_FETCH_TIMEOUT_MS=30000
LLM_FETCH_RETRIES=1

# Rate limiting configuration
RATE_LIMIT_LLM_PER_USER_PER_MIN=60
RATE_LIMIT_LLM_GLOBAL_PER_MIN=600
RATE_LIMIT_LLM_WINDOW_MS=60000

# Performance monitoring
ENABLE_PERFORMANCE_MONITORING=true
METRICS_RETENTION_HOURS=24
ALERT_WEBHOOK_URL=

# Circuit breaker settings (optional overrides)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000
CIRCUIT_BREAKER_RESET_TIMEOUT=300000
