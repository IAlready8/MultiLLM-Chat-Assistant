{
  "name": "personal-llm-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build:webpack",
    "build:preview:local": "bash scripts/vercel-preview-run.sh -- npm run build",
    "build:turbopack": "prisma generate && next build",
    "build:vercel": "bash scripts/build-vercel.sh",
    "build:webpack": "prisma generate && next build --webpack",
    "ci:local": "bash scripts/run-ci-local.sh",
    "clean": "bash scripts/clean.sh",
    "clean:all": "bash scripts/clean.sh --all",
    "clean:deep": "bash scripts/clean.sh --deep",
    "dev": "npm run dev:webpack",
    "dev:turbopack": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "env:validate": "bash scripts/validate-env.sh",
    "lint": "eslint . --max-warnings=0",
    "postinstall": "prisma generate",
    "preflight": "bash scripts/preflight.sh",
    "protect:main": "bash scripts/enforce-branch-protection.sh",
    "reliability:check": "bash scripts/reliability-check.sh",
    "setup:env": "bash scripts/prepare-env-from-example.sh",
    "smoke": "bash scripts/smoke-test.sh",
    "smoke:preview:local": "bash scripts/vercel-preview-run.sh -- bash scripts/smoke-test.sh --base-url http://127.0.0.1:3000 --start-server",
    "smoke:preview:local:auth": "RUN_WITH_DOTENV_OVERRIDE=NEXTAUTH_URL NEXTAUTH_URL=http://127.0.0.1:3000 SMOKE_AUTH_NAME=PreviewSmoke SMOKE_AUTH_EMAIL=preview-smoke@example.test SMOKE_AUTH_PASSWORD=preview-smoke-pass-1234 bash scripts/vercel-preview-run.sh -- bash scripts/smoke-test.sh --base-url http://127.0.0.1:3000 --start-server",
    "start": "next start",
    "test": "vitest --passWithNoTests",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "test:run:local": "vitest run --pool=threads --max-workers=1",
    "test:ui": "vitest --ui",
    "type-check": "tsc -p . --noEmit",
    "upgrade:next:prep": "bash scripts/next-upgrade-readiness.sh",
    "validate:all": "bash scripts/run-all-checks.sh",
    "verify:preview:local": "bash scripts/vercel-preview-run.sh -- bash scripts/verify-production.sh",
    "verify:prod": "bash scripts/verify-production.sh"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "7.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "framer-motion": "^12.35.2",
    "idb": "^8.0.0",
    "lucide-react": "^0.354.0",
    "next": "^16.2.6",
    "next-auth": "^4.24.7",
    "next-themes": "^0.2.1",
    "pg": "^8.20.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.15.4",
    "redis": "^5.11.0",
    "stripe": "^20.4.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.11",
    "@types/pg": "^8.15.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.0.1",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "jsdom": "^26.1.0",
    "postcss": "^8",
    "prisma": "7.7.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "vercel": "^50.9.6",
    "vitest": "^3.2.4"
  }
}
