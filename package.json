{
  "name": "personal-llm-tool",
  "version": "0.2.0-private-pilot.2",
  "private": true,
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": "22.x",
    "npm": ">=10 <12"
  },
  "scripts": {
    "build": "npm run build:webpack",
    "build:preview:local": "bash scripts/vercel-preview-run.sh -- npm run build",
    "build:turbopack": "prisma generate && next build",
    "build:vercel": "bash scripts/build-vercel.sh",
    "build:webpack": "prisma generate && next build --webpack",
    "ci:local": "bash scripts/run-ci-local.sh",
    "clean": "bash scripts/clean.sh",
    "clean:all": "bash scripts/clean.sh --all",
    "clean:deep": "bash scripts/clean.sh --deep",
    "dev": "npm run dev:webpack",
    "dev:turbopack": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "env:validate": "bash scripts/validate-env.sh",
    "check:secrets": "bash scripts/check-no-secrets.sh",
    "check:artifacts": "bash scripts/check-generated-artifacts.sh",
    "check:hygiene": "npm run check:secrets && npm run check:artifacts",
    "coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint . --max-warnings=0",
    "ops:alias:check": "node scripts/alias-commit-guard.mjs",
    "auth:audit-legacy-users": "node scripts/audit-legacy-auth-users.mjs",
    "auth:delete-legacy-user": "node scripts/delete-legacy-auth-user.mjs",
    "postinstall": "prisma generate",
    "preflight": "bash scripts/preflight.sh",
    "protect:main": "bash scripts/enforce-branch-protection.sh",
    "reliability:check": "bash scripts/reliability-check.sh",
    "setup:env": "bash scripts/prepare-env-from-example.sh",
    "smoke": "bash scripts/smoke-test.sh",
    "smoke:preview:local": "bash scripts/vercel-preview-run.sh -- bash scripts/smoke-test.sh --base-url http://127.0.0.1:3000 --start-server",
    "smoke:preview:local:auth": "RUN_WITH_DOTENV_OVERRIDE=NEXTAUTH_URL NEXTAUTH_URL=http://127.0.0.1:3000 SMOKE_REQUIRE_AUTH=true bash scripts/vercel-preview-run.sh -- bash scripts/smoke-test.sh --base-url http://127.0.0.1:3000 --start-server",
    "start": "next start",
    "test": "vitest --passWithNoTests",
    "test:ci": "npm run coverage",
    "test:coverage": "npm run coverage",
    "test:run": "vitest run --passWithNoTests",
    "test:run:local": "vitest run --pool=threads --max-workers=1",
    "test:ui": "vitest --ui",
    "type-check": "tsc -p . --noEmit",
    "upgrade:next:prep": "bash scripts/next-upgrade-readiness.sh",
    "validate:all": "bash scripts/run-all-checks.sh",
    "verify:preview:local": "bash scripts/vercel-preview-run.sh -- bash scripts/verify-production.sh",
    "verify:prod": "bash scripts/verify-production.sh",
    "pilot:validate": "node scripts/validate-private-pilot-tracker.mjs",
    "pilot:invite": "node scripts/create-private-pilot-invite.mjs"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "framer-motion": "^12.35.2",
    "idb": "^8.0.0",
    "lucide-react": "^0.354.0",
    "next": "^16.2.12",
    "next-auth": "^4.24.15",
    "next-themes": "^0.2.1",
    "pg": "^8.20.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.15.4",
    "redis": "^5.11.0",
    "stripe": "^20.4.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.0.1",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.23",
    "prisma": "7.9.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vercel": "^56.5.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@tootallnate/once": "2.0.1",
    "@hono/node-server": "1.19.14",
    "ajv@>=8 <8.18.0": "8.18.0",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.2",
    "brace-expansion@4": "4.0.1",
    "brace-expansion@5": "5.0.8",
    "fast-uri": "3.1.4",
    "find-my-way": "9.7.0",
    "flatted": "3.4.2",
    "form-data": "4.0.6",
    "hono": "4.12.32",
    "js-yaml@>=4 <4.3.0": "4.3.0",
    "lodash": "4.18.1",
    "minimatch@>=10 <10.2.3": "10.2.5",
    "path-to-regexp@>=4 <6.3.0": "6.3.0",
    "path-to-regexp@>=8 <8.4.0": "8.4.2",
    "picomatch@<2.3.2": "2.3.2",
    "picomatch@>=4.0.0 <4.0.4": "4.0.5",
    "postcss": "$postcss",
    "sharp": "0.35.3",
    "smol-toml": "1.7.0",
    "tar": "7.5.22",
    "valibot": "1.4.2",
    "uuid": "$uuid",
    "vite": "$vite",
    "ws": "8.21.1"
  }
}
